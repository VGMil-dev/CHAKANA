# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Connect (embedded flows)
# Publishable key for client-side Stripe.js
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key (backend/Edge Functions only)
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Restricted API key for creating ephemeral keys (if using embedded elements)
# STRIPE_RESTRICTED_API_KEY=rk_test_...

# App config
APP_BASE_URL=https://your-app-domain.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
