# Copiar este archivo a .env y rellenar con tus valores reales
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Usuario de prueba (crear en Supabase Auth dashboard)
QA_TEST_EMAIL=qa-test@yourproject.dev
QA_TEST_PASSWORD=YourPassword123!

# ID del negocio de prueba (ver tabla businesses en Supabase dashboard)
QA_BUSINESS_ID=your-business-uuid

# IDs opcionales para pruebas de comercio/checkout
QA_COMMERCE_TAMBU_ID=your-tambu-uuid
QA_COMMERCE_PRODUCT_ID=your-product-uuid
