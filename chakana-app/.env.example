# Copia este archivo como .env y completa los valores publicos del runtime Expo.
# Los secretos de Stripe/Supabase service role se configuran solo en Supabase Edge Function Secrets.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AURIO_MINT=

# LI.FI (opcional, funciona sin key con rate limit publico)
# EXPO_PUBLIC_LIFI_API_KEY=

# Edge Function secrets requeridos para Stripe Connect:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_BASE_URL=chakana://checkout
# STRIPE_CONNECT_COUNTRY=US
# STRIPE_PLATFORM_FEE_CENTS=0
# AURIO_MINT_ADDRESS=
# AURIO_MINT_AUTHORITY_KEYPAIR=[...]
# SOLANA_RPC_URL=https://api.devnet.solana.com
